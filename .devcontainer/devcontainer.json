{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "OCaml Development Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "learn-you-ocaml",
  "build": {
    "args": {
      "DOCKER_GID": "${localEnv:DOCKER_GID}"
    }
  },
  "features": {},
  "customizations": {},
  "remoteUser": "opam",
  "privileged": true, // Required to run Docker in Docker
  "postStartCommand": "direnv allow /learn-you-ocaml",
  "mounts": [
    "source=${localWorkspaceFolder},target=/learn-you-ocaml,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind", // Mount Docker socket
    "source=${localEnv:HOME}/.ssh,target=/home/opam/.ssh,type=bind",
    "source=${localWorkspaceFolder},target=/workspaces/myers-estate,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/nvim,target=/home/node/.config/nvim,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.dotfiles,target=/home/node/.dotfiles,type=bind,consistency=cached"
  ],
  "runArgs": [
    "--privileged" // Required to run Docker-in-Docker
  ]
}
